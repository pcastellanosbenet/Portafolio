# Proveedor principal: groq | gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b

# Fallback opcional y desactivado por defecto. Para activarlo, usa:
# LLM_FALLBACK_PROVIDER=gemini
# LLM_FALLBACK_MODEL=gemini-3.8-flash
# Gemini puede fallar o agotar su cuota diaria; no es una reserva ilimitada.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Claves (nunca se versionan)
GROQ_API_KEY=
GEMINI_API_KEY=
# Tavily free tier: 1000 API calls/month. Cache queries and track usage.
TAVILY_API_KEY=

# Búsqueda: live | frozen
RESEARCH_SEARCH_BACKEND=live
# tavily | duckduckgo | frozen
RESEARCH_SEARCH_PRIMARY=tavily
# duckduckgo | none
RESEARCH_SEARCH_FALLBACK=duckduckgo
RESEARCH_TAVILY_MONTHLY_BUDGET=1000
TAVILY_SEARCH_DEPTH=basic
WIKIPEDIA_LANG=es

# Persistencia, caché y límites de red
RESEARCH_DB_PATH=artifacts/research.db
RESEARCH_CHECKPOINT_PATH=artifacts/checkpoints.db
RESEARCH_CACHE_TTL_S=86400
RESEARCH_SEARCH_MAX_RESULTS=5
RESEARCH_SEARCH_MAX_RETRIES=1
RESEARCH_HTTP_TIMEOUT_S=20
RESEARCH_HTTP_MAX_BYTES=2000000
RESEARCH_FETCH_MAX_CHARS=12000
RESEARCH_FROZEN_CORPUS_PATH=eval/frozen/corpus.json

# Presupuesto del grafo
RESEARCH_MAX_LLM_CALLS=30
RESEARCH_MAX_TOKENS=60000
RESEARCH_MAX_ROUNDS=2
RESEARCH_MAX_WORKERS=2
RESEARCH_MAX_TOOL_STEPS=2
# Pausa antes del writer. Reanuda con --resume --thread-id <id> --approve|--reject.
RESEARCH_HITL=false

# Parámetros del cliente LLM
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3
LLM_STRUCTURED_METHOD=function_calling
# Límite de tokens por minuto del tier gratuito (0 desactiva el limitador).
LLM_TPM_LIMIT=8000
LLM_TPM_WINDOW_S=60
LLM_MAX_OUTPUT_TOKENS=3000
# El fallback de Gemini puede no soportar todas las herramientas; desactivado por defecto.
LLM_TOOL_FALLBACK=false

# Juez de la evaluación (Fase 4). Si JUDGE_PROVIDER es distinto de LLM_PROVIDER,
# JUDGE_MODEL es obligatorio. Sin JUDGE_MODEL se usa LLM_FAST_MODEL.
RESEARCH_JUDGE_PROVIDER=
RESEARCH_JUDGE_MODEL=
RESEARCH_JUDGE_MAX_OUTPUT_TOKENS=1200
RESEARCH_JUDGE_MAX_RETRIES=1
