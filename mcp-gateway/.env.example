# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
GATEWAY_PUBLIC_URL=http://127.0.0.1:8765/mcp
GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8765
GATEWAY_AUTH_MODE=none
GATEWAY_TOKEN=
GATEWAY_ALLOWLIST=
GATEWAY_SCOPES_SUPPORTED=gateway.call
GATEWAY_REQUIRED_SCOPE=
GATEWAY_GRANTED_SCOPES=
GATEWAY_UPSTREAMS=docs,research,ops
GATEWAY_ROUTER_MODE=hybrid
GATEWAY_TOP_K=8
GATEWAY_APPROVAL_MODE=risk
GATEWAY_APPROVAL_SECRET=
GATEWAY_APPROVAL_TTL_S=300
GATEWAY_DB_PATH=artifacts/gateway.db
GATEWAY_MAX_OUTPUT_BYTES=32768
GATEWAY_REQUEST_TIMEOUT_S=30
GATEWAY_UPSTREAM_TIMEOUT_S=20
GATEWAY_MAX_RETRIES=2

# Upstreams
DOCS_MCP_URL=http://127.0.0.1:8766/mcp
OPS_MCP_URL=http://127.0.0.1:8767/mcp
RESEARCH_MCP_COMMAND=python3.12 -m src.upstreams.research.server
# fixtures = offline y determinista; live = Wikipedia/arXiv reales
RESEARCH_MODE=fixtures

# Modelo para el host y la evaluación (nunca se versiona la clave)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
GROQ_API_KEY=
