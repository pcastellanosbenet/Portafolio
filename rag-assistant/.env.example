# Corpus local (no se incluye en Git)
KNX_CORPUS_DIR=../RAG-Agent/The KNX Standard v3.0.0

# Artefactos e índice
RAG_ARTIFACTS_DIR=artifacts
RAG_COLLECTION_NAME=knx_v3_0_0
# Si se define, se usa un servidor Qdrant; si no, modo local en QDRANT_PATH.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_PATH=artifacts/qdrant

# Embeddings
RAG_EMBEDDING_BACKEND=transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DIMENSION=384
RAG_EMBEDDING_BATCH_SIZE=16
RAG_USE_RERANKER=true
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# LLM local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300
OLLAMA_NUM_THREAD=2

# API
RAG_ADMIN_API_KEY=
RAG_TOP_K=8
RAG_CANDIDATE_K=30
RAG_RERANK_K=20
RAG_MAX_CONTEXT_TOKENS=3000
